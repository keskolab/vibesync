{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeSync",
  "version": "0.1.0",
  "identifier": "com.keskolabs.codesync",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Code Sync",
        "width": 320,
        "height": 548,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": true
      },
      {
        "label": "onboarding",
        "url": "onboarding.html",
        "title": "Welcome to Code Sync",
        "width": 520,
        "height": 664,
        "visible": false,
        "center": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
