{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeSync",
  "mainBinaryName": "VibeSync",
  "version": "0.3.2",
  "identifier": "com.keskolabs.vibesync",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "VibeSync",
        "width": 320,
        "height": 548,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": true
      },
      {
        "label": "onboarding",
        "url": "onboarding.html",
        "title": "Welcome to VibeSync",
        "width": 520,
        "height": 664,
        "visible": false,
        "center": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxREY5MDBEMEFBODU4MEYKUldRUFdLZ0tEWkRmNGJudDVFSnBlL1pmcnB5UXFHRy84aHhKdXk5Y3hzUC9qaUNnN1BMQVdybmQK",
      "endpoints": [
        "https://github.com/keskolab/vibesync/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}